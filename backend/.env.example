# Local development configuration (never commit real credentials)
OCI_GENAI_API_KEY=
OCI_REGION=us-chicago-1
# Optional Responses-compatible root, for example:
# https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com/20231130/actions/v1
OCI_GENAI_BASE_URL=
OCI_GROK_MODEL_ID=xai.grok-4.3
OCI_GROK_MULTI_AGENT_MODEL_ID=xai.grok-4.20-multi-agent

# Overseas securities market data. The API key remains server-side only.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
ALPHA_VANTAGE_API_KEY=

DATABASE_URL=sqlite:///./data/quant_advisor.db
SECRET_KEY=change-me-for-non-local-environments

# Local UI login. Keep real values only in backend/.env (which is git-ignored).
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=5
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
